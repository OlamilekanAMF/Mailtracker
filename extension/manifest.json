{
  "manifest_version": 3,
  "name": "Mailtrack (internal)",
  "version": "1.1.0",
  "description": "Tracks sent and read status for Gmail, Outlook, Zoho Mail and Yahoo Mail.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Mailtrack" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://mail.zoho.com/*",
        "https://mail.zoho.eu/*",
        "https://mail.zoho.in/*",
        "https://mail.zoho.com.au/*",
        "https://mail.yahoo.com/*"
      ],
      "js": ["providers.js", "content.js", "bounce.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
